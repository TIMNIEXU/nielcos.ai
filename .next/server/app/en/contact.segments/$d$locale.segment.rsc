ub":"NIEL AI watches every shipment, tariff change, and document — and flags what matters with a clear dollar impact.","title":"Risks surface before they cost you."},"compliance":{"eyebrow":"Compliance Center","items":[{"n":"FDA","v":"98%"},{"n":"USDA","v":"96%"},{"n":"APHIS","v":"94%"},{"n":"EPA","v":"91%"}],"overall":"Overall compliance","sub":"Every entry is checked against participating government agency requirements automatically — before CBP ever asks.","title":"Regulators, handled."},"cta":{"b1":"Request a demo","b2":"Talk to our team","sub":"See NIEL COS on your own shipments in a 30-minute working session.","title":"Put your trade operation under command."},"hero":{"badge":"AI-powered · Live trade data","cta1":"Request a demo","cta2":"Explore the platform","eyebrow":"Niel Customs Operating System","sub":"NIEL COS unifies customs brokerage, shipments, compliance, documents, and finance in a single AI-powered operating system — so every entry, container, and dollar is visible, predictable, and under control.","titleA":"Your entire global trade","titleB":"operation, under one command."},"kpis":[{"delta":"+1.2 pts this quarter","label":"Entry acceptance rate","value":"98.6%"},{"delta":"vs. manual brokerage","label":"Faster customs clearance","value":"40%"},{"delta":"for customers last year","label":"Duty savings identified","value":"$$2.4M"},{"delta":"across every shipment","label":"AI trade monitoring","value":"24/7"}],"marquee":["Customs brokerage","Ocean & air freight","Drayage & trucking","Warehousing","Duty optimization","Trade compliance","Supply chain finance","Control tower visibility"],"modules":{"cta":"View all modules","eyebrow":"One platform","items":[{"desc":"AI-assisted entry filing, HTS classification, and PGA compliance in one flow.","name":"Customs"},{"desc":"End-to-end tracking across ocean, air, and drayage with milestone alerts.","name":"Shipments"},{"desc":"Continuous screening against FDA, USDA, APHIS, and EPA requirements.","name":"Compliance"},{"desc":"Invoices, packing lists, and certificates parsed, stored, and linked to entries.","name":"Documents"},{"desc":"Trucking, warehousing, and fulfillment orchestrated around your freight.","name":"Logistics"},{"desc":"Duty, freight, and landed-cost visibility with pay and financing tools.","name":"Finance"},{"desc":"Ask anything about your trade operations — in plain language.","name":"AI Assistant"},{"desc":"One live view of every shipment, risk, and exception worldwide.","name":"Control Tower"}],"sub":"Stop stitching together brokers, forwarders, spreadsheets, and email threads. NIEL COS brings every function of global trade into one operating system.","title":"Every trade function. One screen."},"network":{"cities":[{"d":"Port & customs hub","n":"New York / New Jersey"},{"d":"West coast gateway","n":"Los Angeles"},{"d":"Midwest distribution","n":"Chicago"}],"eyebrow":"Where we operate","sub":"Operated alongside Joma Logistics Inc — moving freight since 2008 — with teams on both coasts and the Midwest.","title":"From here to anywhere."}},"meta":{"description":"NIEL COS unifies customs, shipments, compliance, documents, and finance in one AI-powered operating system for global trade. One group. One global trade solution.","title":"NIEL COS — AI Global Trade Operating System"},"mock":{"aiTitle":"AI Executive Intelligence","analyze":"Analyze with NIEL AI","greetSub":"Here's what's happening with your global trade operations today.","greeting":"Good morning, Tim","kpi1":"Total Shipments","kpi2":"Customs Entries","kpi3":"Alerts & Risks","kpi4":"Trade Exposure","mapTitle":"Global Trade Overview","recent":"Recent Shipments","riskTitle":"material risks detected","viewAll":"View All"},"modulesPage":{"cta":{"b1":"Request a demo","b2":"Contact us","sub":"Start there. We'll have it live on your operation in weeks, not quarters.","title":"Which module hurts most right now?"},"hero":{"eyebrow":"Modules","sub":"Start with the module you need today. The rest are already connected when you're ready.","titleA":"Twelve modules.","titleB":"Zero blind spots."},"items":[{"d":"Entry filing, HTS classification, PGA messaging, and liquidation tracking — the brokerage desk, modernized.","n":"Customs","points":["AI-suggested HTS codes","PGA compliance checks","Entry status tracking"]},{"d":"Every container and airwaybill tracked across carriers with milestone alerts and exception workflows.","n":"Shipments","points":["Multi-carrier tracking","Milestone alerts","Exception queues"]},{"d":"Denied-party screening, admissibility rules, and audit-ready records for every transaction.","n":"Compliance","points":["Automated screening","Audit trail","Regulatory updates"]},{"d":"Commercial invoices, packing lists, and certificates parsed by AI and pinned to the right entry.","n":"Documents","points":["AI document parsing","Version control","One-click sharing"]},{"d":"Your SKU catalog with HTS, duty rates, and PGA flags maintained in one place.","n":"Products","points":["HTS library","Duty rate tracking","PGA flagging"]},{"d":"Supplier profiles, documentation status, and performance scoring across your vendor base.","n":"Suppliers","points":["Vendor scorecards","Document collection","Risk flags"]},{"d":"Drayage, trucking, and warehousing coordinated with your customs timeline — no more demurrage surprises.","n":"Logistics","points":["Drayage coordination","Warehouse slots","Demurrage watch"]},{"d":"Landed cost, duty payables, and cash-flow timing for every shipment — finance finally speaks freight.","n":"Finance","points":["Landed-cost engine","Duty forecasting","Pay & finance tools"]},{"d":"Ask about any shipment, entry, or regulation in plain language and get a sourced answer in seconds.","n":"AI Assistant","points":["Natural-language Q&A","Cited sources","24/7 availability"]}]},"nav":{"contact":"Contact","demo":"Request a demo","home":"Home","modules":"Modules","platform":"Platform"},"platform":{"cta":{"b1":"Request a demo","b2":"View modules","sub":"Bring one lane, one product, one headache — we'll show you what NIEL COS does with it.","title":"See the platform on your freight."},"features":[{"d":"Every shipment carries one GTTID from PO to proof of delivery. Trace any carton, entry, or invoice to its origin in seconds — no more hunting across systems.","t":"Global Trade Transaction ID"},{"d":"Machine-suggested HTS codes with confidence scoring, plus duty-rate analysis that finds legal savings before you file — not after you overpay.","t":"AI classification & duty engineering"},{"d":"PGA requirements, admissibility checks, and document validation run continuously against every entry. Exceptions arrive with a fix, not just a flag.","t":"Compliance automation"},{"d":"Ocean, air, and drayage milestones stream into one live map. At-risk shipments escalate automatically with owner, impact, and next action.","t":"Control tower visibility"},{"d":"Duty, freight, warehousing, and fees roll into true landed cost per SKU. Pay vendors, manage cash flow, and forecast with trade-accurate numbers.","t":"Landed-cost finance"},{"d":"Connect your ERP, WMS, or forwarder via API and EDI. NIEL COS meets your stack where it lives — no rip-and-replace required.","t":"Open integrations"}],"hero":{"eyebrow":"The platform","sub":"NIEL COS is built on a Trade-to-Cash spine: every order, shipment, entry, and payment linked by a single Global Trade Transaction ID — from purchase order to final delivery.","titleA":"One system of record","titleB":"for global trade."},"integration":{"points":["REST API & webhooks","EDI 850 / 856 / 810","ERP & WMS connectors","SSO & audit logs"],"sub":"API-first design with EDI support. Your ERP stays; your spreadsheets retire.","title":"Plays well with your stack"}}},"timeZone":"America/Chicago","children":["$L3","$L4","$L5"]}]}]}]]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@a","rootVary